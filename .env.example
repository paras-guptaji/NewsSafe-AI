# =============================================
# NewsSafe AI - Environment Configuration
# =============================================
# Copy this file to .env inside the backend/ folder
# and fill in your actual API keys.

# -------------------------------------------
# NewsAPI Key
# Get yours at: https://newsapi.org/register
# Free plan: 100 requests/day, top-headlines only for India
# -------------------------------------------
NEWS_API_KEY=781875ad47dd4666808d8b9fc48f3d96

# -------------------------------------------
# Google Gemini API Key (REQUIRED for AI classification)
# Get yours at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1500 requests/day on Gemini Flash
# -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------
# Gemini Model (default: gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
# -------------------------------------------
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------
# SQLite Database URL
# Default: creates newssafe.db in backend/ directory
# -------------------------------------------
DATABASE_URL=sqlite:///./newssafe.db
